# NONSECRET NAME GUIDE ONLY: do not put real values into this file.
# Add these directly to DigitalOcean App Platform > Environment Variables.
CUSTOMU_STAGING_ONLY=YES_FICTIONAL_ONLY
CUSTOMU_ENABLE_CLOUD=RUN_FICTIONAL_PILOT
CUSTOMU_PUBLIC_ORIGIN=${APP_URL}
# Add following as ENCRYPTED RUN_TIME variables, NOT in GitHub:
# CUSTOMU_STAGING_DATABASE_URL=<your existing Supabase Session pooler URI>
# CUSTOMU_PG_CA_B64=<base64 of your previously verified Supabase CA certificate>
